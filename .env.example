# Copy to .env and fill in. .env is gitignored; never commit real values.

# LAN IP of the inverter. Leave blank to try UDP broadcast discovery.
INVERTER_IP=192.168.x.x

# 502 = Modbus TCP (default). 8899 = UDP, for dongles without Modbus TCP.
INVERTER_PORT=502

# Where to keep the database. Leave blank for data/solar-monitor.db in the repo.
DB_PATH=

# Which address the dashboard listens on. Leave blank for this machine only.
# 0.0.0.0 opens it to the local network, and the app won't start that way until it has accounts.
# Never forward it at the router, with or without accounts.
BIND_HOST=

# Accounts aren't set here: they live in the database. Make the first, the owner's, named admin,
# on the machine that runs the app, with: solar-monitor reset-password admin
# The same command sets a forgotten password. Admins add everyone else on the Users screen.
# Without any accounts there's no login, which only works on this machine.
#
# DASHBOARD_USER and DASHBOARD_PASSWORD, from before there were accounts, aren't used any more.
# If there are no accounts yet, the app makes the owner's from DASHBOARD_PASSWORD once, then asks
# for both to be removed.
