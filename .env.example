# Copy to .env and fill in. .env is gitignored; never commit real values.

# LAN IP of the inverter. Leave blank to try UDP broadcast discovery.
INVERTER_IP=192.168.x.x

# 502 = Modbus TCP (default). 8899 = UDP, for dongles without Modbus TCP.
INVERTER_PORT=502

# Where to keep the database. Leave blank for data/solar-monitor.db in the repo.
DB_PATH=

# Which address the dashboard listens on. Leave blank for this machine only.
# 0.0.0.0 opens it to the local network, and the app won't start that way without a login below.
# Never forward it at the router, with or without a login.
BIND_HOST=

# The dashboard's login. Leave both blank for no login, which only works on this machine.
# Store a hash of the password rather than the password itself. This asks for the password and prints the line:
#   python -m solar_monitor.password
# The password itself still works, and the app warns about it when it starts.
# If you do put the password itself, wrap it in single quotes if it contains spaces or a #.
# Use a password you don't use anywhere else: at home it isn't encrypted on the way across the network.
DASHBOARD_USER=
DASHBOARD_PASSWORD=
